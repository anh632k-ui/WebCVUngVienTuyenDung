@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho

title COMPONENT ARCHITECTURE - BACKEND & AI PIPELINE

package "FastAPI API Layer" {
  component "auth.py" as AuthAPI
  component "users.py" as UsersAPI
  component "skills.py" as SkillsAPI
  component "resumes.py" as ResumeAPI
  component "jobs.py" as JobsAPI
  component "matching.py" as MatchAPI
  component "router.py" as Router
  Router --> AuthAPI
  Router --> UsersAPI
  Router --> SkillsAPI
  Router --> ResumeAPI
  Router --> JobsAPI
  Router --> MatchAPI
}

package "Core" {
  component "config.py" as Config
  component "database.py" as Database
  component "security.py" as Security
  component "idempotency.py\nUUIDv5 create guard" as Idem
  component "version_guard.py\nexclusive version/state/delete CAS" as Guard
}

package "Service Layer" {
  component "Auth/User Service" as UserService
  component "skill_service.py" as SkillService
  component "resume_service.py" as ResumeService
  component "job_service.py" as JobService
  component "match_service.py" as MatchService
}

package "AI Pipeline" {
  component "pdf/docx_extractor.py" as Extractor
  component "entity_recognizer.py" as Entity
  component "skill_normalizer.py" as Normalizer
  component "vector_embedding.py\nmodel + preprocessing version" as Vector
  component "matching_engine.py" as Engine
  component "xai_adapter.py [Advanced]" as XAI
}

package "ORM and DTO" {
  component "SQLAlchemy Models" as ORM
  component "Pydantic Schemas" as DTO
}

package "Background Tasks" {
  component "task_dispatcher.py" as Dispatcher
  component "parse_recovery.py\nstartup/periodic PENDING sweep" as Recovery
  component "celery_tasks.py\nexpected versions in task payload" as Tasks
}

database "PostgreSQL 18 + pgvector" as DB
component "Redis/Celery [when enabled]" as Queue

AuthAPI --> UserService
UsersAPI --> UserService
SkillsAPI --> SkillService
ResumeAPI --> ResumeService
JobsAPI --> JobService
MatchAPI --> MatchService
AuthAPI --> DTO
UsersAPI --> DTO
SkillsAPI --> DTO
ResumeAPI --> DTO
JobsAPI --> DTO
MatchAPI --> DTO

UserService --> ORM
SkillService --> ORM
ResumeService --> ORM
JobService --> ORM
MatchService --> ORM
ResumeService --> Idem : POST create
JobService --> Idem : POST create
Idem --> ORM : deterministic id / load existing
ResumeService --> Guard
JobService --> Guard
MatchService --> Guard
Guard --> ORM : status + expected-version + delete-state CAS
ORM --> Database
Database --> DB

ResumeService --> Dispatcher
JobService --> Dispatcher
MatchService --> Dispatcher
Recovery --> ORM : scan PENDING + is_deleted=false
Recovery --> Dispatcher : re-dispatch current revision
Dispatcher --> Queue
Queue --> Tasks
Tasks --> Guard : exclusive claim/terminal CAS
Tasks --> Extractor
Tasks --> Entity
Tasks --> Normalizer
Tasks --> Vector
Tasks --> Engine
Engine --> XAI
Tasks --> ORM

note bottom of Guard
Parse: claim requires PENDING, terminal requires PROCESSING,
both require expected revision + is_deleted=false.
Match: claim requires PENDING, terminal requires PROCESSING,
both require expected generation/revisions + linked resources not deleted.
end note

note bottom of Recovery
Recovery does not increment revision.
Duplicate dispatch is safe because only one worker can claim PENDING.
No blind PROCESSING reset in MVP without lease/attempt token.
end note

Security --> UserService
Config --> Database
Config --> Security
@enduml
