@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho

title SYSTEM ARCHITECTURE - WEBCVUNGVIENTUYENDUNG

node "Client" {
  [Candidate Browser] as Candidate
  [HR Browser] as HR
  [Admin Browser] as Admin
}

package "Presentation Layer" {
  [Next.js App Router\nTypeScript + Tailwind CSS] as Frontend
  [HTTP API Client] as HttpClient
  Frontend --> HttpClient
}

package "Application Layer - FastAPI" {
  [API v1 Router] as Router
  [Auth / RBAC / Ownership] as Security
  [User Service] as UserService
  [Resume Service] as ResumeService
  [Job Service] as JobService
  [Matching Service] as MatchService
  [Idempotency / UUIDv5 Guard] as IdemGuard
  [Revision / Generation / Delete-state CAS Guard] as VersionGuard
  [Task Dispatcher] as Dispatcher
  [Parse Recovery Sweeper] as Recovery

  Router --> Security
  Router --> UserService
  Router --> ResumeService
  Router --> JobService
  Router --> MatchService
  ResumeService --> IdemGuard : create POST
  JobService --> IdemGuard : create POST
  ResumeService --> VersionGuard
  JobService --> VersionGuard
  MatchService --> VersionGuard
  ResumeService --> Dispatcher
  JobService --> Dispatcher
  MatchService --> Dispatcher
  Recovery --> Dispatcher : re-dispatch PENDING
}

package "AI / NLP & Background Processing" {
  [Celery Worker\n(or development fallback)] as Worker
  [Text Extractor\npdfplumber/python-docx] as Extractor
  [OCR Adapter\nAdvanced] as OCR
  [Entity / Section Extractor] as Entity
  [Skill Normalizer\nseeded taxonomy] as Normalizer
  [Embedding Service\nmodel + preprocessing version] as Embedding
  [BM25 Adapter\ndiagnostic v1] as BM25
  [Hybrid Matching Engine] as Matching
  [LLM/XAI Adapter\nAdvanced] as LLM

  Worker --> Extractor
  Extractor --> OCR : fallback when enabled
  Worker --> Entity
  Worker --> Normalizer
  Worker --> Embedding
  Worker --> Matching
  Matching --> BM25
  Matching --> LLM : explanation only
}

package "Persistence / Infrastructure" {
  database "PostgreSQL 18 + pgvector\nrevision/generation/delete state" as DB
  database "Redis\nTask broker [when enabled]" as Redis
  folder "CV File Storage\nput-if-absent on create" as Storage
}

Candidate --> Frontend : HTTPS
HR --> Frontend : HTTPS
Admin --> Frontend : HTTPS
HttpClient --> Router : REST/JSON + Idempotency-Key on create

UserService --> DB
ResumeService --> DB
JobService --> DB
MatchService --> DB
IdemGuard --> DB : deterministic resource id / existing row
VersionGuard --> DB : exclusive status/version/delete-aware CAS
Recovery --> DB : scan PENDING + not deleted only
ResumeService --> Storage
Worker --> Storage
Worker --> DB : claim/terminal write via exclusive CAS
Dispatcher --> Redis : queue when enabled
Redis --> Worker

note bottom of IdemGuard
POST /resumes/upload và POST /jobs:
UUIDv5(actor + route + Idempotency-Key).
Retry same logical request -> same resource id.
CV storage retry never overwrites existing object.
end note

note bottom of VersionGuard
Parse claim: expected revision + PENDING + is_deleted=false.
Parse terminal: same revision + PROCESSING + is_deleted=false.
Match claim: expected generation/revisions + PENDING + linked not-deleted.
Match terminal: same expected values + PROCESSING + linked not-deleted.
Stale/duplicate/deleted task rowcount=0 -> discard.
end note

note bottom of Recovery
Immediate dispatch failure after DB commit:
keep resource PENDING.
Startup/periodic sweep re-dispatches current revision if not deleted.
No revision increment. MVP does not reset PROCESSING blindly.
end note

note bottom of Security
MVP: JWT Access Token.
Refresh Rotation/HttpOnly session là Advanced.
end note
@enduml
