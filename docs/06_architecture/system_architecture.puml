@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho

title SYSTEM ARCHITECTURE - WEBCVUNGVIENTUYENDUNG

node "Client" {
  [Candidate Browser] as Candidate
  [HR Browser] as HR
  [Admin Browser] as Admin
}

package "Presentation Layer" {
  [Next.js App Router\nTypeScript + Tailwind CSS] as Frontend
  [HTTP API Client] as HttpClient
  Frontend --> HttpClient
}

package "Application Layer - FastAPI" {
  [API v1 Router] as Router
  [Auth / RBAC / Ownership] as Security
  [User Service] as UserService
  [Resume Service] as ResumeService
  [Job Service] as JobService
  [Matching Service] as MatchService
  [Revision / Generation Guard] as VersionGuard
  [Task Dispatcher] as Dispatcher

  Router --> Security
  Router --> UserService
  Router --> ResumeService
  Router --> JobService
  Router --> MatchService
  ResumeService --> VersionGuard
  JobService --> VersionGuard
  MatchService --> VersionGuard
  ResumeService --> Dispatcher
  JobService --> Dispatcher
  MatchService --> Dispatcher
}

package "AI / NLP & Background Processing" {
  [Celery Worker\n(or development fallback)] as Worker
  [Text Extractor\npdfplumber/python-docx] as Extractor
  [OCR Adapter\nAdvanced] as OCR
  [Entity / Section Extractor] as Entity
  [Skill Normalizer\nseeded taxonomy] as Normalizer
  [Embedding Service\nmodel + preprocessing version] as Embedding
  [BM25 Adapter\ndiagnostic v1] as BM25
  [Hybrid Matching Engine] as Matching
  [LLM/XAI Adapter\nAdvanced] as LLM

  Worker --> Extractor
  Extractor --> OCR : fallback when enabled
  Worker --> Entity
  Worker --> Normalizer
  Worker --> Embedding
  Worker --> Matching
  Matching --> BM25
  Matching --> LLM : explanation only
}

package "Persistence / Infrastructure" {
  database "PostgreSQL 18 + pgvector\nrevision/generation state" as DB
  database "Redis\nTask broker [when enabled]" as Redis
  folder "CV File Storage" as Storage
}

Candidate --> Frontend : HTTPS
HR --> Frontend : HTTPS
Admin --> Frontend : HTTPS
HttpClient --> Router : REST/JSON

UserService --> DB
ResumeService --> DB
JobService --> DB
MatchService --> DB
VersionGuard --> DB : conditional writes
ResumeService --> Storage
Worker --> Storage
Worker --> DB : terminal write guarded by expected versions
Dispatcher --> Redis : queue when enabled
Redis --> Worker

note bottom of VersionGuard
Parse task: expected resource revision.
Match task: expected generation + Resume/JD revisions.
Stale task must not overwrite newer state.
end note

note bottom of Security
MVP: JWT Access Token.
Refresh Rotation/HttpOnly session là Advanced.
end note
@enduml
