@startuml
skinparam linetype ortho
skinparam monochrome true
skinparam shadowing false

entity "users" as users {
  * id : UUID <<PK>>
  --
  * email : VARCHAR(255) <<UQ>>
  * password_hash : VARCHAR(255)
  * full_name : VARCHAR(100)
  * phone_number : VARCHAR(20)
  * role : VARCHAR(20) <<CHECK>>
  * is_active : BOOLEAN
  * created_at : TIMESTAMP WITH TIME ZONE
  * updated_at : TIMESTAMP WITH TIME ZONE
}

entity "skills" as skills {
  * id : SERIAL <<PK>>
  --
  * name : VARCHAR(100) <<UQ>>
  * normalized_name : VARCHAR(100) <<UQ>>
  * category : VARCHAR(50)
  * description : TEXT
  * created_at : TIMESTAMP WITH TIME ZONE
}

entity "resumes" as resumes {
  * id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * file_name : VARCHAR(255)
  * file_path : VARCHAR(500)
  * file_size : INTEGER
  * mime_type : VARCHAR(100)
  * parsing_status : VARCHAR(20) <<CHECK>>
  raw_text : TEXT
  resume_embedding : vector(1024)
  is_deleted : BOOLEAN
  created_at : TIMESTAMP WITH TIME ZONE
  parsed_at : TIMESTAMP WITH TIME ZONE
}

entity "resume_skills" as resume_skills {
  * id : BIGSERIAL <<PK>>
  --
  * resume_id : UUID <<FK>>
  * skill_id : INTEGER <<FK>>
  years_of_experience : NUMERIC(3,1)
  proficiency_level : VARCHAR(20)
}

entity "resume_experiences" as resume_experiences {
  * id : BIGSERIAL <<PK>>
  --
  * resume_id : UUID <<FK>>
  * company_name : VARCHAR(150)
  * job_title : VARCHAR(100)
  start_date : DATE
  end_date : DATE
  is_current : BOOLEAN
  description : TEXT
}

entity "resume_educations" as resume_educations {
  * id : BIGSERIAL <<PK>>
  --
  * resume_id : UUID <<FK>>
  * institution_name : VARCHAR(150)
  * degree : VARCHAR(100)
  field_of_study : VARCHAR(100)
  graduation_year : SMALLINT
  gpa : NUMERIC(3,2)
}

entity "job_descriptions" as job_descriptions {
  * id : UUID <<PK>>
  --
  * recruiter_id : UUID <<FK>>
  * title : VARCHAR(200)
  * job_level : VARCHAR(50)
  location : VARCHAR(150)
  * raw_content : TEXT
  min_experience_years : NUMERIC(3,1)
  job_embedding : vector(1024)
  w_skill : NUMERIC(3,2)
  w_semantic : NUMERIC(3,2)
  w_experience : NUMERIC(3,2)
  status : VARCHAR(20) <<CHECK>>
  is_deleted : BOOLEAN
  created_at : TIMESTAMP WITH TIME ZONE
  updated_at : TIMESTAMP WITH TIME ZONE
}

entity "job_skills" as job_skills {
  * id : BIGSERIAL <<PK>>
  --
  * job_id : UUID <<FK>>
  * skill_id : INTEGER <<FK>>
  * skill_type : VARCHAR(20) <<CHECK>>
  min_years_required : NUMERIC(3,1)
}

entity "match_results" as match_results {
  * id : UUID <<PK>>
  --
  * job_id : UUID <<FK>>
  * resume_id : UUID <<FK>>
  * overall_score : NUMERIC(5,2)
  * skill_score : NUMERIC(5,2)
  * semantic_score : NUMERIC(5,2)
  * experience_score : NUMERIC(5,2)
  matched_skills : JSONB
  missing_skills : JSONB
  gap_analysis_summary : TEXT
  status : VARCHAR(20) <<CHECK>>
  calculated_at : TIMESTAMP WITH TIME ZONE
}

' Mối quan hệ giữa các bảng
users ||..o{ resumes : "tải lên (1:N)"
users ||..o{ job_descriptions : "đăng tuyển (1:N)"

resumes ||--o{ resume_skills : "sở hữu (1:N)"
resumes ||--o{ resume_experiences : "có (1:N)"
resumes ||--o{ resume_educations : "có (1:N)"

skills ||--o{ resume_skills : "được tham chiếu (1:N)"
skills ||--o{ job_skills : "được yêu cầu (1:N)"

job_descriptions ||--o{ job_skills : "yêu cầu (1:N)"

job_descriptions ||--o{ match_results : "được so khớp (1:N)"
resumes ||--o{ match_results : "tham gia so khớp (1:N)"

@enduml