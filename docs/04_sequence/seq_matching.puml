@startuml
skinparam monochrome true
skinparam shadowing false
title SEQUENCE - HYBRID MATCHING WITH EXCLUSIVE GENERATION/REVISION CAS

actor "Candidate/HR/Admin" as User
participant "Next.js" as FE
participant "Matching API" as API
participant "Matching Service" as Service
database "PostgreSQL + pgvector" as DB
participant "Task Dispatcher" as Dispatcher
queue "Redis/Celery" as Queue
participant "Matching Worker" as Worker
participant "Hybrid Engine" as Engine

User -> FE : chọn JD + CV(s)
FE -> API : POST /matching/calculate
API -> Service : calculate(current_user,payload)
Service -> DB : load JD + ALL CVs
Service -> Service : validate full batch ownership/readiness\nmodel+preprocessing + is_deleted=FALSE
alt any invalid
  Service --> API : 403/404/422
  API --> FE : error, no Match mutation
else all valid
  Service -> DB : BEGIN
  loop each resume
    Service -> DB : UPSERT current pair\ngeneration++, snapshot current resume/job revision\nPENDING + clear stale payload
    DB --> Service : match_id + generation + snapshots
  end
  Service -> DB : COMMIT
  loop each match
    Service -> Dispatcher : enqueue(match_id,generation,resume_revision,job_revision,algorithm)
    Dispatcher -> Queue : task
  end
  alt any dispatch failure
    Service --> API : 503 TASK_DISPATCH_FAILED
    API --> FE : retry-safe error
  else all accepted
    Service --> API : 202 match_ids,total_matches,status=PENDING
    API --> FE : accepted
  end
end

Queue -> Worker : expected generation/revisions
Worker -> DB : exclusive CAS PENDING->PROCESSING\nWHERE id + generation + snapshots match expected\nAND linked revisions match expected\nAND Resume/JD is_deleted=FALSE
alt rowcount=0
  Worker -> Worker : stale/duplicate/deleted task -> discard
else exclusive claim acquired
  Worker -> DB : load Match + Resume + JD + criteria
  Worker -> Worker : verify model/preprocessing + not deleted
  alt mismatch/deleted/error
    Worker -> DB : CAS FAILED,error\nWHERE status='PROCESSING'\nAND generation/snapshots/linked revisions expected\nAND Resume/JD is_deleted=FALSE
    alt rowcount=0
      Worker -> Worker : stale/duplicate/deleted terminal -> discard
    end
  else current
    Worker -> Engine : compute hybrid-v1
    Engine --> Worker : scores/evidence
    Worker -> DB : terminal CAS COMPLETED\nWHERE status='PROCESSING'\nAND generation/snapshots/linked revisions expected\nAND Resume/JD is_deleted=FALSE
    alt rowcount=0
      Worker -> Worker : stale/duplicate/deleted result -> discard
    else committed
      Worker -> Worker : done
    end
  end
end

note over Queue,Worker
At-least-once/duplicate delivery is expected-safe:
only one worker can claim a PENDING generation.
FAILED and COMPLETED both require the same exclusive PROCESSING claim.
Concurrent soft-delete invalidates terminal writes.
end note
@enduml
