@startuml
skinparam monochrome true
skinparam shadowing false
title SEQUENCE - HYBRID MATCHING WITH GENERATION/REVISION GUARD

actor "Candidate/HR/Admin" as User
participant "Next.js" as FE
participant "Matching API" as API
participant "Matching Service" as Service
database "PostgreSQL + pgvector" as DB
participant "Task Dispatcher" as Dispatcher
queue "Redis/Celery" as Queue
participant "Matching Worker" as Worker
participant "Hybrid Engine" as Engine

User -> FE : chọn JD + CV(s)
FE -> API : POST /matching/calculate
API -> Service : calculate(current_user,payload)
Service -> DB : load JD + ALL CVs
Service -> Service : validate full batch ownership/readiness\nmodel+preprocessing versions
alt any invalid
  Service --> API : 403/404/422
  API --> FE : error, no Match mutation
else all valid
  Service -> DB : BEGIN
  loop each resume
    Service -> DB : UPSERT current pair\ngeneration++, snapshot resume/job revision\nPENDING + clear stale payload
    DB --> Service : match_id + generation
  end
  Service -> DB : COMMIT
  loop each match
    Service -> Dispatcher : enqueue(match_id,generation,resume_revision,job_revision,algorithm)
    Dispatcher -> Queue : task
  end
  alt any dispatch failure
    Service --> API : 503 TASK_DISPATCH_FAILED
    API --> FE : retry-safe error
  else all accepted
    Service --> API : 202 match_ids,total_matches,status=PENDING
    API --> FE : accepted
  end
end

Queue -> Worker : expected generation/revisions
Worker -> DB : conditional UPDATE PROCESSING\nWHERE id + generation match expected
alt rowcount=0
  Worker -> Worker : stale task -> discard
else claimed
  Worker -> DB : load Match + Resume + JD + criteria
  Worker -> Worker : compare linked revisions/model/preprocessing
  alt mismatch
    Worker -> Worker : stale task -> discard
  else current
    Worker -> Engine : compute hybrid-v1
    Engine --> Worker : scores/evidence
    Worker -> DB : conditional terminal UPDATE COMPLETED\nFROM linked Resume/JD WHERE generation+revisions still match
    alt rowcount=0
      Worker -> Worker : stale result -> discard
    else committed
      Worker -> Worker : done
    end
  end
end
@enduml
