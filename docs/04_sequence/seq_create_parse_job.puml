@startuml
skinparam monochrome true
skinparam shadowing false
title SEQUENCE - CREATE/UPDATE & PARSE JD WITH REVISION GUARD

actor HR
participant "Next.js" as FE
participant "Jobs API" as API
participant "Job Service" as Service
database "PostgreSQL" as DB
participant "Task Dispatcher" as Dispatcher
queue "Redis/Celery" as Queue
participant "JD Worker" as Worker
participant "JD NLP/Embedding" as NLP

== Create ==
HR -> FE : nhập JD
FE -> API : POST /api/v1/jobs
API -> Service : create_job(HR,payload)
Service -> DB : INSERT DRAFT/PENDING, revision=1, recruiter_id=HR.id
DB --> Service : job_id
Service -> Dispatcher : enqueue(job_id, expected_revision=1)
Dispatcher -> Queue : task
Service --> API : 201 JobResponse

== Update raw content ==
HR -> FE : sửa raw_content
FE -> API : PUT /jobs/{id}
API -> Service : update_job(...)
Service -> DB : verify HR owner/Admin existing JD
Service -> DB : BEGIN
Service -> DB : revision++, DRAFT/PENDING, verified=false\nclear embedding/model/preprocessing/parsed_at
Service -> DB : invalidate Matches: generation++, PENDING, clear stale payload
Service -> DB : COMMIT
Service -> Dispatcher : enqueue(job_id,new_revision)
Dispatcher -> Queue : task
Service --> API : 200

== Parse ==
Queue -> Worker : job_id, expected_revision
Worker -> DB : conditional UPDATE PROCESSING WHERE revision=expected_revision
alt rowcount=0
  Worker -> Worker : stale -> discard
else claimed
  Worker -> NLP : parse criteria + embedding
  alt error
    Worker -> DB : conditional FAILED + parsing_error_message
  else success
    Worker -> DB : transaction replace job_skills + parsed fields\nPARSED + model/preprocessing WHERE revision=expected_revision
    alt terminal rowcount=0
      Worker -> Worker : stale result -> discard
    end
  end
end
@enduml
