@startuml
skinparam monochrome true
skinparam shadowing false
title SEQUENCE - UPLOAD & PARSE CV - FINGERPRINTED IDEMPOTENCY + EXCLUSIVE CAS

actor "Candidate/HR" as User
participant "Next.js" as FE
participant "Resume API" as API
participant "Resume Service" as Service
participant "Idempotency/UUIDv5 + SHA-256" as Idem
participant "File Storage" as Storage
database "PostgreSQL" as DB
participant "Task Dispatcher" as Dispatcher
participant "Parse Recovery Sweeper" as Recovery
queue "Redis/Celery" as Queue
participant "CV Worker" as Worker
participant "NLP/Embedding" as NLP

User -> FE : chọn file
FE -> FE : generate Idempotency-Key UUID
FE -> API : POST /resumes/upload + Idempotency-Key
API -> Service : upload(current_user,key,file)
Service -> Service : read bytes + validate size/MIME/magic
Service -> Idem : SHA-256(raw bytes)
Idem --> Service : request_fingerprint
Service -> Idem : UUIDv5(FIXED_NAMESPACE, actor+route+key)
Idem --> Service : deterministic resume_id
Service -> DB : lookup resume_id for current owner
alt existing resource
  DB --> Service : Resume + create_request_fingerprint
  alt fingerprint mismatch
    Service --> API : 409 IDEMPOTENCY_KEY_REUSED
    API --> FE : conflict
  else same fingerprint
    Service -> Service : do NOT overwrite storage
    opt existing status=PENDING and is_deleted=FALSE
      Service -> Dispatcher : best-effort re-dispatch(resume_id,current_revision)
    end
    Service --> API : 202 same ResumeUploadResponse
    API --> FE : same resource
  end
else no DB row
  Service -> Service : storage_key=resumes/{resume_id}/source
  Service -> Storage : put-if-absent(raw bytes)
  alt object already exists
    Storage --> Service : existing object
    Service -> Storage : read/hash existing object
    Storage --> Service : object_fingerprint
    alt object fingerprint mismatch
      Service --> API : 409 IDEMPOTENCY_KEY_REUSED
      API --> FE : conflict, no overwrite
    else same fingerprint
      Service -> Service : reuse verified orphan object
    end
  else object created
    Storage --> Service : created
  end
  Service -> DB : INSERT Resume(PENDING,revision=1,id=resume_id,create_request_fingerprint)
  alt deterministic PK race
    DB --> Service : unique conflict
    Service -> DB : re-read resume_id
    DB --> Service : persisted fingerprint
    alt persisted fingerprint mismatch
      Service --> API : 409 IDEMPOTENCY_KEY_REUSED
    else same fingerprint
      Service -> Service : use existing resource
    end
  else inserted
    Service -> DB : COMMIT persistence
  end
  Service -> Dispatcher : best-effort enqueue(resume_id,current_revision)
  alt dispatcher accepted
    Dispatcher -> Queue : task
  else dispatcher failed
    Service -> Service : log failure, keep PENDING
  end
  Service --> API : 202 ResumeUploadResponse
  API --> FE : accepted/existing
end

note over Service,Storage
Nếu storage write thành công nhưng DB insert fail,
object có thể còn orphan. Retry chỉ reuse sau khi
SHA-256 object == request fingerprint.
Không overwrite object khi mismatch.
end note

== Recovery for post-commit dispatch failure ==
Recovery -> DB : SELECT PENDING Resume\nWHERE is_deleted=FALSE and older than grace
DB --> Recovery : resume_id,current_revision
Recovery -> Dispatcher : re-dispatch(resume_id,current_revision)
Dispatcher -> Queue : task
note over Recovery,Queue
Recovery không tăng revision và không đổi state.
Duplicate delivery an toàn nhờ exclusive CAS claim.
end note

== Worker ==
Queue -> Worker : resume_id, expected_revision
Worker -> DB : CAS UPDATE PROCESSING\nWHERE id=? AND revision=?\nAND parsing_status='PENDING' AND is_deleted=FALSE
alt rowcount=0
  Worker -> Worker : stale/duplicate/deleted -> discard
else exclusive claim acquired
  Worker -> Storage : read file
  Worker -> NLP : extract + normalize + embed
  alt processing error
    Worker -> DB : CAS FAILED,error\nWHERE revision=? AND parsing_status='PROCESSING'\nAND is_deleted=FALSE
  else success
    Worker -> DB : BEGIN + lock/check revision=?\nAND PROCESSING AND is_deleted=FALSE
    alt check failed
      Worker -> DB : ROLLBACK
      Worker -> Worker : stale/duplicate/deleted -> discard
    else current claim
      Worker -> DB : save aggregate + embedding/model/preprocessing
      Worker -> DB : CAS PARSED\nWHERE revision=? AND parsing_status='PROCESSING'\nAND is_deleted=FALSE
      Worker -> DB : COMMIT
      note right of Worker
      Worker không tăng revision.
      Concurrent soft-delete làm CAS/check fail.
      end note
    end
  end
end

FE -> API : GET /resumes/{id}/status
API -> Service : authorize owner/Admin + active resource
Service -> DB : SELECT status WHERE is_deleted=FALSE
DB --> Service : status
Service --> API : 200
API --> FE : status
@enduml
