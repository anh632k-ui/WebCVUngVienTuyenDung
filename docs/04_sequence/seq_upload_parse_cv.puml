@startuml
skinparam monochrome true
skinparam shadowing false
title SEQUENCE - UPLOAD & PARSE CV WITH REVISION GUARD

actor "Candidate/HR" as User
participant "Next.js" as FE
participant "Resume API" as API
participant "Resume Service" as Service
participant "File Storage" as Storage
database "PostgreSQL" as DB
participant "Task Dispatcher" as Dispatcher
queue "Redis/Celery" as Queue
participant "CV Worker" as Worker
participant "NLP/Embedding" as NLP

User -> FE : chọn file
FE -> API : POST /resumes/upload
API -> Service : upload(current_user,file)
Service -> Service : validate size/MIME/magic
Service -> Storage : save safe storage_key
Service -> DB : INSERT Resume(PENDING, revision=1)
DB --> Service : resume_id
Service -> Dispatcher : enqueue(resume_id, expected_revision=1)
Dispatcher -> Queue : task
Service --> API : 202 PENDING

Queue -> Worker : resume_id, expected_revision
Worker -> DB : UPDATE PROCESSING\nWHERE id=? AND revision=expected_revision
alt rowcount=0
  Worker -> Worker : stale task -> discard
else claimed
  Worker -> Storage : read file
  Worker -> NLP : extract + normalize + embed
  alt processing error
    Worker -> DB : UPDATE FAILED,error\nWHERE id=? AND revision=expected_revision
  else success
    Worker -> DB : transaction save aggregate + embedding/model/preprocessing\nUPDATE PARSED WHERE id=? AND revision=expected_revision
    alt terminal rowcount=0
      Worker -> Worker : stale task -> discard result
    end
  end
end

FE -> API : GET /resumes/{id}/status
API -> Service : authorize owner/Admin
Service -> DB : SELECT status
DB --> Service : status
Service --> API : 200
API --> FE : status
@enduml
