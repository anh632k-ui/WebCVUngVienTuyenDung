@startuml
skinparam monochrome true
skinparam shadowing false

title SEQUENCE - REVIEW JD CRITERIA & UPDATE WEIGHTS

actor "HR/Admin" as User
participant "Next.js" as FE
participant "Jobs API" as API
participant "Job Service" as Service
database "PostgreSQL" as DB
participant "Task Dispatcher" as Dispatcher

== Review criteria ==
User -> FE : mở Criteria
FE -> API : GET /jobs/{id}/criteria
API -> Service : get_criteria(current_user,id)
Service -> DB : verify recruiter_id/Admin + SELECT JD/job_skills
DB --> Service : criteria
Service --> API : criteria DTO
API --> FE : 200

User -> FE : chỉnh experience/education/skills
FE -> API : GET /skills?keyword=...
API -> Service : search taxonomy
Service -> DB : SELECT skills
DB --> Service : skill options
Service --> API : taxonomy DTO
API --> FE : 200

User -> FE : lưu criteria
FE -> API : PUT /jobs/{id}/criteria
API -> Service : update_criteria(current_user,id,payload)
Service -> Service : validate ownership, >=1 skill,\nskill IDs, duplicates, values
alt invalid
  Service --> API : validation error
  API --> FE : 422
else valid
  Service -> DB : transaction update JD + replace/upsert job_skills\nset is_criteria_verified=true
  DB --> Service : commit
  Service --> API : updated criteria
  API --> FE : 200
end

== Weights ==
User -> FE : chỉnh w_skill/w_semantic/w_experience
FE -> API : PUT /jobs/{id}/weights
API -> Service : update_weights(...)
Service -> Service : validate each [0,1] and sum=1.000
alt invalid
  Service --> API : validation error
  API --> FE : 422
else valid
  Service -> DB : UPDATE job_descriptions weights
  opt recalculate=true
    Service -> DB : mark related completed matches PENDING/reset stale scores
    Service -> Dispatcher : enqueue recalculation jobs
  end
  Service --> API : success
  API --> FE : 200
end

@enduml
