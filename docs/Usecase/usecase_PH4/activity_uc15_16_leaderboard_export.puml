@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC15 & UC16: Bảng xếp hạng, Tinh chỉnh trọng số & Xuất file

start
:HR mở màn hình "Bảng xếp hạng ứng viên theo JD";
:Frontend gửi GET /api/v1/jobs/{id}/leaderboard?sort=score_desc;

partition "Leaderboard Generation" {
  :Backend JOIN bảng `match_results`, `resumes`, `candidate_profiles`;
  :Lọc theo job_id và sắp xếp ORDER BY overall_score DESC;
  :Trả về JSON danh sách ứng viên xếp hạng theo thứ tự điểm cao nhất;
  :Frontend render bảng xếp hạng kèm thanh đo độ tương thích (Progress Bar %);
}

if (HR thực hiện thao tác?) then ([Điều chỉnh trọng số])
  :HR kéo thanh trượt (Slider):
  - Tăng trọng số Kỹ năng cứng (w_skill)
  - Giảm trọng số Ngữ nghĩa (w_semantic);
  
  :Frontend kiểm tra điều kiện:
  Tổng các trọng số = 1.0 (w_skill + w_semantic + w_exp == 1.0)?;
  
  :HR bấm "Áp dụng và Tính toán lại";
  :Gửi PUT /api/v1/jobs/{id}/weights { w_skill, w_semantic, w_exp };
  
  :Backend cập nhật trọng số và kích hoạt recalculate trong Transaction;
  :Cập nhật lại toàn bộ điểm `overall_score` trong bảng `match_results`;
  :Bảng xếp hạng trên giao diện tự động refresh vị trí;

else if (HR thực hiện [Xuất báo cáo]) then ([Xuất báo cáo])
  :HR chọn định dạng: [PDF Tổng hợp] hoặc [Excel Chi tiết];
  :Gửi GET /api/v1/jobs/{id}/export?format=pdf|excel;
  
  partition "Report Generator Engine" {
    :Backend đọc dữ liệu bảng xếp hạng và ma trận so khớp;
    if (Format == Excel) then (Excel)
      :Dùng openpyxl tạo file bảng tính:
      Cột điểm tổng, điểm kỹ năng, các kỹ năng thiếu/đạt;
    else (PDF)
      :Dùng Weasyprint/ReportLab tạo báo cáo đồ họa:
      Logo, biểu đồ thống kê, tóm tắt top ứng viên sáng giá;
    endif
    
    :Trả về Stream file nhị phân kèm Header Content-Type chuẩn;
  }
  :Trình duyệt tải file báo cáo về máy HR;

else ([Xem chi tiết 1 ứng viên])
  :HR click vào dòng ứng viên để mở modal đối chiếu sâu;
endif

stop
@enduml