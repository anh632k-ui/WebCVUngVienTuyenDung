@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho

actor "Nhà tuyển dụng\n(HR)" as HR
actor "Ứng viên\n(Candidate)" as Candidate
actor "Tiến trình tính toán AI\n(AI Matching Engine)" as MatchingEngine

rectangle "Phân hệ 4: So khớp Ngữ nghĩa & Phân tích khoảng trống kỹ năng" {
  usecase "UC12: Kích hoạt so khớp CV với JD\n(Đơn lẻ hoặc Hàng loạt)" as UC12
  usecase "UC13: Tính điểm tương thích\n(Hybrid Matching Algorithm)" as UC13
  usecase "UC13.1: So khớp quy tắc Kỹ năng\n(Hard Rule Matching)" as UC13_1
  usecase "UC13.2: So khớp ngữ nghĩa Vector\n(Semantic Cosine Similarity)" as UC13_2
  usecase "UC14: Phân tích khoảng cách kỹ năng\n(Skill Gap & Đề xuất học tập)" as UC14
  usecase "UC15: Xem bảng xếp hạng & Đối soát chi tiết" as UC15
  usecase "UC16: Cấu hình trọng số thuật toán" as UC16
  usecase "UC16.1: Xuất báo cáo ứng viên\n(Export PDF/Excel)" as UC16_1
}

' Phân quyền người dùng
HR --> UC12
HR --> UC15
HR --> UC16
HR --> UC16_1

Candidate --> UC12
Candidate --> UC14
Candidate --> UC15

' Worker tính toán ngầm
UC13 <-- MatchingEngine
UC14 <-- MatchingEngine

' Quan hệ phụ thuộc
UC12 ..> UC13 : <<trigger>>
UC13 ..> UC13_1 : <<include>>
UC13 ..> UC13_2 : <<include>>
UC13 ..> UC14 : <<include>>
UC15 <.. UC16_1 : <<extend>>
UC16 ..> UC13 : <<influences>>

@enduml