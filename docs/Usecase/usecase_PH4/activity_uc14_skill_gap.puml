@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC14: Phân tích khoảng cách kỹ năng (Skill Gap)

start
:Ứng viên hoặc HR mở xem báo cáo chi tiết kết quả so khớp;
:Frontend gửi GET /api/v1/matching/{match_id}/gap-analysis;

partition "Gap Analysis Engine" {
  :Truy vấn `match_results` để lấy danh sách `missing_skills`;
  
  :Phân loại mức độ nghiêm trọng của Skill Gap:
  - Critical Gap: Thiếu kỹ năng thuộc nhóm Bắt buộc (Mandatory)
  - Minor Gap: Thiếu kỹ năng thuộc nhóm Ưu tiên (Optional);
  
  :Tra cứu Tri thức Kỹ năng (Taxonomy Knowledge Base):
  Đối với mỗi kỹ năng bị thiếu:
  - Xác định Độ khó & Lộ trình bù đắp (Thời gian học ước lượng)
  - Đề xuất các khóa học hoặc tài liệu chuẩn liên quan;
  
  :Tính Chỉ số Sẵn sàng nghề nghiệp (Job Readiness Index):
  Readiness = (Số kỹ năng hiện có) / (Tổng kỹ năng yêu cầu);
}

partition "Client Visualization" {
  :Trả về HTTP 200 kèm JSON cấu trúc Gap;
  :Frontend render giao diện trực quan:
  - Biểu đồ mạng nhện (Radar Chart) so sánh Năng lực thực tế vs Tiêu chuẩn JD
  - Danh sách Thẻ màu: Xanh (Đã đạt), Đỏ (Kỹ năng bắt buộc thiếu), Vàng (Kỹ năng ưu tiên thiếu)
  - Hộp gợi ý: "Lộ trình khắc phục để đạt 100% tiêu chí";
}

stop
@enduml