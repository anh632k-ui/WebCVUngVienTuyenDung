@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC12: Kích hoạt so khớp CV với JD

start
:Người dùng (Candidate hoặc HR) vào giao diện Match;

if (Vai trò người dùng?) then (Candidate)
  :Chọn 1 CV cá nhân đã được Parse;
  :Chọn 1 JD đang mở tuyển (Active);
  :Gửi POST /api/v1/matching/single-match
  { resume_id, job_id };
else (HR)
  :Chọn 1 JD cần tuyển;
  :Chọn danh sách CV ứng tuyển (hoặc chọn "Tất cả CV trong kho");
  :Gửi POST /api/v1/matching/batch-match
  { job_id, resume_ids: [id1, id2, ...] };
endif

partition "Backend Validation & Job Queue" {
  :Kiểm tra trạng thái CV và JD trong Database;
  if (Cả CV và JD đều đã ở trạng thái 'PARSED/COMPLETED'?) then (Hợp lệ)
    :Tạo các bản ghi mới trong bảng `match_results`
    với trạng thái status = 'PENDING';
    
    :Đẩy các Job tính toán vào Task Queue (Celery/Redis):
    Mỗi task chứa { match_id, resume_id, job_id };
    
    :Trả về HTTP 202 Accepted
    kèm { task_id, total_jobs, status: 'QUEUED' };
    
    :Frontend hiển thị thông báo "Hệ thống đang tiến hành phân tích & chấm điểm...";
  else (Chưa bóc tách xong)
    :Trả về HTTP 422 Unprocessable Entity
    ("Hồ sơ hoặc JD chưa hoàn tất quá trình trích xuất dữ liệu");
    end
  endif
}

stop
@enduml