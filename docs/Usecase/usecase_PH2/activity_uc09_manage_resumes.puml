@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC09: Quản lý kho hồ sơ CV

start
:Người dùng truy cập màn hình Kho CV;
:Frontend gửi GET /api/v1/resumes
kèm params: page, limit, keyword, skill_ids, status;

partition "Search & Filtering" {
  :Backend nhận query parameters;
  :Kiểm tra vai trò người dùng:
  - Nếu là Candidate: WHERE user_id = current_user
  - Nếu là HR/Admin: Không giới hạn user_id;
  
  :Xây dựng câu lệnh Query tối ưu (kèm phân trang Limit/Offset);
  :Đếm tổng số bản ghi (Total count cho Pagination);
  :Trả về HTTP 200 kèm danh sách tóm tắt và metadata phân trang;
  :Frontend render bảng danh sách CV;
}

if (Người dùng chọn thao tác?) then ([Tải file gốc])
  :Gửi GET /api/v1/resumes/{id}/download;
  :Backend xác thực quyền;
  :Đọc file nhị phân từ đường dẫn lưu trữ;
  :Trả về HTTP 200 kèm Header `Content-Disposition: attachment`;
  :Trình duyệt tự động tải file PDF/DOCX;

else if (Thao tác [Xóa hồ sơ]) then ([Xóa])
  :Người dùng bấm "Xóa" và xác nhận xác nhận Popup cảnh báo;
  :Gửi DELETE /api/v1/resumes/{id};
  :Backend kiểm tra quyền sở hữu;
  partition "Soft Delete & Cleanup" {
    :Thực hiện xóa mềm (UPDATE is_deleted = TRUE, deleted_at = NOW());
    :Hoặc xóa cứng (Xóa record trong DB và xóa file vật lý trên đĩa);
    :Trả về HTTP 204 No Content;
  }
  :Frontend xóa dòng tương ứng trên bảng dữ liệu;

else ([Không thao tác thêm])
  :Xem thông tin;
endif

stop
@enduml