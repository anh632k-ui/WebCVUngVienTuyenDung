@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC07: Pipeline Bóc tách NLP cho CV

start
:Worker (Celery/Daemon) lấy Message từ Hàng đợi:
{ "resume_id": UUID, "file_path": path };

:Cập nhật trạng thái bảng `resumes`:
status = 'PROCESSING';

partition "Text Extraction Layer" {
  if (File type == DOCX?) then (DOCX)
    :Đọc bằng thư viện python-docx;
    :Trích xuất Raw Text thô;
  else (PDF)
    :Mở file bằng thư viện pdfplumber / PyMuPDF;
    :Trích xuất chuỗi ký tự theo từng trang;
    if (Độ dài Text trích xuất >= 50 ký tự?) then (Có Text Layer)
      :Thu nhận Raw Text;
    else (File scan dạng ảnh rỗng)
      :Kích hoạt OCR Fallback (PyTesseract / EasyOCR);
      :Chuyển đổi từng trang PDF sang Image;
      :Chạy OCR bóc chữ từ ảnh sang chuỗi Text;
    endif
  endif
}

if (Text trích xuất thành công và có ý nghĩa?) then (Đạt)
  partition "NLP & Entity Extraction Layer" {
    :Tiền xử lý chuỗi: chuẩn hóa Unicode (NFC),
    xóa khoảng trắng thừa và ký tự điều khiển;
    
    :Chạy Regex Pattern:
    - Trích xuất: Email, Số điện thoại, Link GitHub/LinkedIn;
    
    :Chạy mô hình NER (Named Entity Recognition):
    - Trích xuất: Họ tên, Vị trí hiện tại, Trường học;
    
    :Phân đoạn văn bản (Section Segmentation):
    - Tách khối: Skills, Experience, Education;
    
    :Bóc tách khối Kỹ năng & Map với Từ điển:
    - Đối chiếu Skill Taxonomy (vd: 'Node.js' -> ID: 45);
    - Phân loại: Hard Skill, Soft Skill, Tool/Framework;
  }
  
  partition "Database Commit" {
    :INSERT thông tin liên hệ vào `candidate_profiles`;
    :INSERT danh sách kỹ năng vào `resume_skills`;
    :INSERT chi tiết quá trình làm việc vào `resume_experiences`;
    :INSERT quá trình học vấn vào `resume_educations`;
    :UPDATE bảng `resumes`:
    status = 'PARSED',
    parsed_at = NOW();
  }
  
  :Gửi thông báo hoàn tất qua WebSocket (Event: PARSE_SUCCESS);
  
else (Lỗi file rỗng, mã hóa hoặc hỏng)
  :UPDATE bảng `resumes`:
  status = 'FAILED',
  error_message = 'Không thể trích xuất nội dung văn bản';
  :Gửi thông báo qua WebSocket (Event: PARSE_FAILED);
  end
endif

stop
@enduml