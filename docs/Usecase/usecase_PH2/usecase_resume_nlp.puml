@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam monochrome true
skinparam linetype ortho

actor "Ứng viên\n(Candidate)" as Candidate
actor "Nhà tuyển dụng\n(HR)" as HR
actor "Tiến trình nền AI\n(Background AI Worker)" as AIWorker

rectangle "Phân hệ 2: Quản lý CV & Pipeline Bóc tách NLP" {
  usecase "UC06: Tải lên hồ sơ CV\n(PDF/DOCX)" as UC06
  usecase "UC07: Bóc tách thông tin CV\n(NLP/OCR Engine)" as UC07
  usecase "UC07.1: Nhận diện ký tự quang học\n(OCR Fallback Scan)" as UC07_1
  usecase "UC07.2: Chuẩn hóa kỹ năng\n(Skill Taxonomy Mapping)" as UC07_2
  usecase "UC08: Rà soát & chỉnh sửa thông tin CV" as UC08
  usecase "UC09: Quản lý kho hồ sơ CV\n(Tìm kiếm, lọc, xóa)" as UC09
}

' Tác nhân kích hoạt
Candidate --> UC06
Candidate --> UC08
Candidate --> UC09

HR --> UC06
HR --> UC08
HR --> UC09

' Worker chạy ngầm xử lý phân tích
UC07 <-- AIWorker

' Quan hệ phụ thuộc kỹ thuật
UC06 ..> UC07 : <<trigger>>
UC07 <.. UC07_1 : <<extend>>
UC07 ..> UC07_2 : <<include>>
UC08 ..> UC07 : <<precedes>>

@enduml