@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC08: Rà soát & Chỉnh sửa thông tin sau bóc tách

start
:Người dùng vào trang chi tiết hồ sơ;
:Frontend gửi GET /api/v1/resumes/{id}/parsed-data;

partition "Authorization & Load" {
  :Kiểm tra quyền truy cập (User sở hữu hoặc HR/Admin);
  if (Có quyền?) then (Cho phép)
    :Truy vấn chi tiết profile, kỹ năng, kinh nghiệm;
    :Trả về JSON dữ liệu đã bóc tách;
    :Frontend hiển thị 2 cột song song (Split Screen):
    - Cột trái: File PDF xem trước
    - Cột phải: Các ô form thông tin đã trích xuất;
  else (Không có quyền)
    :Trả về HTTP 403 Forbidden;
    end
  endif
}

:Người dùng kiểm tra thông tin, sửa lỗi nếu AI bóc sai
(Ví dụ: gõ lại năm kinh nghiệm, thêm kỹ năng bị sót);
:Bấm nút "Lưu thay đổi";

partition "Validation & Persist" {
  :Frontend gửi PUT /api/v1/resumes/{id}/parsed-data
  kèm payload JSON đã chỉnh sửa;
  :Backend validate schema dữ liệu;
  if (Dữ liệu chuẩn format?) then (Đạt)
    :UPDATE các bảng thông tin liên quan trong Transaction;
    :Đánh dấu cờ `is_manually_edited = true`;
    :COMMIT Database Transaction;
    :Trả về HTTP 200 OK;
    :Thông báo "Cập nhật dữ liệu bóc tách thành công";
  else (Lỗi dữ liệu)
    :Trả về HTTP 422 Unprocessable Entity;
    :Báo lỗi trường dữ liệu không hợp lệ;
  endif
}

stop
@enduml