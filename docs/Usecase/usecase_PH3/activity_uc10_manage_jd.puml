@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC10: Quản lý tin tuyển dụng (JD)

start
:HR đăng nhập và truy cập trang "Quản lý tuyển dụng";

if (HR chọn thao tác?) then ([Tạo JD mới])
  :HR nhập tiêu đề, vị trí, cấp bậc (Junior/Senior),
  địa điểm, mức lương, và dán nội dung mô tả công việc (Raw Text);
  :Bấm nút "Tạo và Bóc tách yêu cầu";
  
  partition "Create & Trigger Backend" {
    :Frontend gửi POST /api/v1/jobs;
    :Backend kiểm tra dữ liệu bắt buộc (Title, Content);
    if (Hợp lệ?) then (Đạt)
      :INSERT bản ghi vào bảng `job_descriptions`
      (Trạng thái: status = 'DRAFT' hoặc 'ACTIVE');
      :Đẩy Message vào Hàng đợi:
      { "job_id": UUID, "content": raw_text };
      :Trả về HTTP 201 Created kèm job_id;
      :Frontend thông báo "Đã tạo JD, AI đang phân tích yêu cầu...";
    else (Lỗi dữ liệu)
      :Trả về HTTP 422 Unprocessable Entity;
      :Hiển thị thông báo lỗi trường nhập liệu;
      end
    endif
  }

else if (Thao tác [Cập nhật thông tin JD]) then ([Cập nhật])
  :HR chỉnh sửa thông tin JD trên Form;
  :Gửi PUT /api/v1/jobs/{id};
  :Backend kiểm tra quyền sở hữu (HR tạo JD này?);
  if (Hợp lệ?) then (Cho phép)
    :UPDATE bảng `job_descriptions`;
    :Trả về HTTP 200 OK;
    :Thông báo "Cập nhật thành công";
  else (Không có quyền)
    :Trả về HTTP 403 Forbidden;
    end
  endif

else if (Thao tác [Đóng / Mở lại đợt tuyển]) then ([Đổi trạng thái])
  :HR bấm nút chuyển Toggle [Đóng tuyển] / [Mở tuyển];
  :Gửi PATCH /api/v1/jobs/{id}/status { status: 'CLOSED' / 'ACTIVE' };
  :Backend cập nhật cột `status`;
  :Trả về HTTP 200 OK;

else (Thao tác [Xóa JD])
  :HR chọn Xóa và xác nhận cảnh báo (Popup);
  :Gửi DELETE /api/v1/jobs/{id};
  partition "Soft Delete Execution" {
    :Backend kiểm tra xem JD đã có dữ liệu so khớp chưa;
    :Đánh dấu `is_deleted = TRUE`, `deleted_at = NOW()`;
    :Trả về HTTP 204 No Content;
  }
  :Frontend ẩn dòng JD khỏi danh sách hiển thị;
endif

stop
@enduml