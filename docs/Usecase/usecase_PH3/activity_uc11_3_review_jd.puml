@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC11.3: Rà soát & Điều chỉnh tiêu chí JD

start
:HR mở trang "Cấu hình tiêu chí đánh giá của JD";
:Frontend gửi GET /api/v1/jobs/{id}/parsed-criteria;

partition "Fetch & Display" {
  :Backend trả về JSON:
  - Số năm kinh nghiệm bóc tách được
  - Danh sách Kỹ năng bắt buộc (Mandatory)
  - Danh sách Kỹ năng ưu tiên (Optional);
  
  :Giao diện hiển thị dạng Tag tương tác:
  [Python - Bắt buộc] [Django - Bắt buộc] [Docker - Ưu tiên];
}

:HR kiểm tra và thực hiện thao tác thủ công:
- Đổi trạng thái: Chuyển một kỹ năng từ Bắt buộc sang Ưu tiên
- Thêm kỹ năng mới từ ô gợi ý Auto-complete
- Xóa kỹ năng bị nhận diện sai
- Chỉnh lại số năm kinh nghiệm;

:HR bấm nút "Lưu tiêu chí chuẩn";

partition "Persist Customized Criteria" {
  :Frontend gửi PUT /api/v1/jobs/{id}/parsed-criteria;
  :Backend nhận payload danh sách kỹ năng mới;
  :Mở Database Transaction:
    - Xóa các kỹ năng cũ trong `job_skills` liên kết với job_id;
    - Bulk Insert danh sách kỹ năng chuẩn vừa được HR phê duyệt;
    - Cập nhật số năm kinh nghiệm vào `job_descriptions`;
    - Đánh dấu cờ `is_criteria_verified = TRUE`;
  :Commit Transaction;
  
  :Trả về HTTP 200 OK;
  :Hiển thị "Đã cập nhật bộ tiêu chí chuẩn để sẵn sàng so khớp";
}

stop
@enduml