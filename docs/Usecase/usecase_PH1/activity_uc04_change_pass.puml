@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC04: Đổi mật khẩu

start
:Người dùng vào chức năng "Đổi mật khẩu";
:Nhập: Mật khẩu hiện tại, Mật khẩu mới, Xác nhận mật khẩu mới;
:Bấm "Cập nhật mật khẩu";

partition "Client Validation" {
  if (Mật khẩu mới == Xác nhận MK\nvà khác Mật khẩu cũ?) then (Thỏa mãn)
    :Gửi PUT /api/v1/auth/change-password;
  else (Không thỏa mãn)
    :Báo lỗi trên giao diện (MK không khớp hoặc trùng MK cũ);
    end
  endif
}

partition "Backend Processing" {
  :Lấy user_id từ Context Token;
  :Query hash mật khẩu hiện tại trong DB;
  
  if (Verify(Mật khẩu hiện tại nhập vào, Hash trong DB) == TRUE?) then (Khớp)
    :Kiểm tra độ phức tạp của Mật khẩu mới;
    if (Đạt chuẩn chính sách mật khẩu?) then (Đạt)
      :Băm mật khẩu mới bằng Bcrypt/Argon2;
      :UPDATE `users` SET password_hash = new_hash WHERE id = user_id;
      :Xóa toàn bộ Refresh Token cũ của user trong Redis
      (Đăng xuất khỏi các thiết bị khác);
      :Trả về HTTP 200 OK;
      :Báo đổi mật khẩu thành công, yêu cầu đăng nhập lại;
    else (Không đạt)
      :Trả về HTTP 422 (Mật khẩu quá yếu);
      end
    endif
  else (Sai mật khẩu cũ)
    :Trả về HTTP 400 Bad Request
    ("Mật khẩu hiện tại không chính xác");
    end
  endif
}

stop
@enduml