@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC05: Quản trị Người dùng (Dành cho Admin)

start
:Admin truy cập trang Quản trị người dùng;
:Frontend gửi GET /api/v1/admin/users?page=1&limit=20;

partition "RBAC Authorization" {
  :Middleware kiểm tra Token claim: role == 'ADMIN'?;
  if (Role != ADMIN) then (Không có quyền)
    :Trả về HTTP 403 Forbidden;
    :Chuyển hướng về trang Access Denied;
    end
  else (Hợp lệ)
    :Truy vấn danh sách User (hỗ trợ phân trang, lọc);
    :Trả về HTTP 200 kèm User List JSON;
    :Render bảng danh sách người dùng;
  endif
}

:Admin chọn thao tác: [Khóa tài khoản] hoặc [Thay đổi vai trò (Role)];
:Admin xác nhận hành động trên Popup modal;

partition "Admin Action Execution" {
  :Gửi request PATCH /api/v1/admin/users/{target_id};
  
  if (target_id == admin_hien_tai_id) then (Tự thao tác chính mình)
    :Trả về HTTP 400 Bad Request
    ("Không được phép tự khóa hoặc hạ quyền tài khoản của chính mình");
    end
  else (Thao tác trên user khác)
    :Cập nhật trạng thái `is_active` hoặc `role` trong DB;
    if (Khóa tài khoản?) then (Đúng)
      :Xóa sạch session/token của target_id trong Redis;
    endif
    :Ghi nhật ký hệ thống (Audit Log: Admin nào, làm gì lúc nào);
    :Trả về HTTP 200 OK;
    :Cập nhật lại giao diện bảng dữ liệu;
  endif
}

stop
@enduml