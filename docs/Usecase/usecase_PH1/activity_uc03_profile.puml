@startuml
skinparam monochrome true
skinparam shadowing false

title Sơ đồ hoạt động - UC03: Quản lý thông tin cá nhân

start
:Người dùng chọn "Xem/Sửa thông tin cá nhân";

partition "Authorization Check" {
  :Client gửi GET /api/v1/users/me (kèm Bearer Token);
  :Middleware trích xuất user_id từ Token;
  if (Token hợp lệ?) then (Hợp lệ)
    :Truy vấn bảng `users` theo user_id;
    :Trả về HTTP 200 kèm Profile JSON;
    :Frontend render thông tin lên form;
  else (Không hợp lệ)
    :Trả về 401 Unauthorized;
    end
  endif
}

:Người dùng chỉnh sửa thông tin (Họ tên, SĐT, Tiêu đề nghề nghiệp);
:Bấm nút "Lưu thay đổi";

partition "Update Process" {
  :Gửi request PUT /api/v1/users/me;
  :Backend validate dữ liệu nhập (Regex SĐT, độ dài tên);
  if (Dữ liệu hợp lệ?) then (Đúng)
    :UPDATE bảng `users` WHERE id = user_id;
    :Ghi log thời gian `updated_at`;
    :Trả về HTTP 200 OK (Thành công);
    :Hiển thị "Cập nhật hồ sơ thành công";
  else (Sai quy chuẩn)
    :Trả về HTTP 422 Unprocessable Entity;
    :Hiển thị lỗi cụ thể từng trường;
  endif
}

stop
@enduml