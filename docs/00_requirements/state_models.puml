@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho

title STATE MODELS - CV / JD / MATCHING

state "Resume Parsing" as Resume {
  [*] --> PENDING
  PENDING --> PROCESSING : worker nhận task
  PROCESSING --> PARSED : parse + embedding thành công
  PROCESSING --> FAILED : parse lỗi
  FAILED --> PENDING : retry
  PARSED --> PENDING : re-parse thủ công/nâng cấp pipeline
}

state "Job Parsing" as JobParsing {
  [*] --> J_PENDING
  J_PENDING --> J_PROCESSING : worker nhận task
  J_PROCESSING --> J_PARSED : parse + embedding thành công
  J_PROCESSING --> J_FAILED : parse lỗi
  J_FAILED --> J_PENDING : retry
  J_PARSED --> J_PENDING : raw_content thay đổi
}

state "Job Business Status" as JobBusiness {
  [*] --> DRAFT
  DRAFT --> ACTIVE : publish [PARSED + verified + có job_skill]
  ACTIVE --> CLOSED : HR/Admin đóng tuyển
  CLOSED --> ACTIVE : mở lại [vẫn đủ điều kiện publish]
  ACTIVE --> DRAFT : raw_content thay đổi / unpublish
  CLOSED --> DRAFT : raw_content thay đổi
}

state "Match Lifecycle" as Matching {
  [*] --> M_PENDING
  M_PENDING --> M_PROCESSING : worker nhận task
  M_PROCESSING --> M_COMPLETED : tính điểm thành công
  M_PROCESSING --> M_FAILED : lỗi
  M_FAILED --> M_PENDING : retry/recalculate
  M_COMPLETED --> M_PENDING : criteria/weights/CV/model/algorithm thay đổi
}

note bottom of JobBusiness
Mọi thay đổi raw_content làm criteria/embedding cũ stale,
vì vậy business status bị đưa về DRAFT trước khi Job Parsing về PENDING.
ACTIVE/matching còn được service kiểm tra có ít nhất một job_skill hợp lệ.
end note

@enduml
