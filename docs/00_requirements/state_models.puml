@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
title STATE MODELS - CV / JD / MATCHING

state "Resume Parsing" as Resume {
  [*] --> PENDING
  PENDING --> PROCESSING : task(expected_revision)
  PROCESSING --> PARSED : success + revision still matches
  PROCESSING --> FAILED : error + revision still matches
  FAILED --> PENDING : retry/reparse
  PARSED --> PENDING : explicit reparse / pipeline upgrade
}

state "Job Parsing" as JobParsing {
  [*] --> J_PENDING
  J_PENDING --> J_PROCESSING : task(expected_revision)
  J_PROCESSING --> J_PARSED : success + revision still matches
  J_PROCESSING --> J_FAILED : error + revision still matches
  J_FAILED --> J_PENDING : retry
  J_PARSED --> J_PENDING : raw_content/model/preprocessing change
}

state "Job Business Status" as JobBusiness {
  [*] --> DRAFT
  DRAFT --> ACTIVE : ready
  ACTIVE --> DRAFT : unpublish/edit
  ACTIVE --> CLOSED : close
  CLOSED --> DRAFT : prepare/edit
  CLOSED --> ACTIVE : reopen [ready]
}

state "Match Lifecycle" as Matching {
  [*] --> M_PENDING
  M_PENDING --> M_PROCESSING : task(generation,revisions)
  M_PROCESSING --> M_COMPLETED : conditional terminal write
  M_PROCESSING --> M_FAILED : conditional terminal write
  M_FAILED --> M_PENDING : retry => generation++
  M_COMPLETED --> M_PENDING : invalidate => generation++
}

note bottom of JobBusiness
same-state PATCH idempotent.
DRAFT -> CLOSED is invalid.
ACTIVE requires PARSED + verified + embedding/model/preprocessing
+ >=1 job_skill.
end note

note bottom of Matching
Worker must re-check generation + Resume revision + JD revision.
If any expected value differs, task is stale and must not overwrite.
FAILED requires error_message; other states require error_message=NULL.
end note
@enduml
