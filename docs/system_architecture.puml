@startuml
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho

title SƠ ĐỒ KIẾN TRÚC HỆ THỐNG TỔNG THỂ (3-TIER SYSTEM ARCHITECTURE)

node "Client Layer (Trình duyệt Người dùng)" {
  [Ứng viên (Candidate)] as ClientCandidate
  [Nhà tuyển dụng (HR)] as ClientHR
}

package "Presentation Layer (Frontend App)" {
  [Next.js / ReactJS + Tailwind CSS] as FrontendApp
  [State Management / Axios Client] as APIClient
  FrontendApp --> APIClient
}

package "Application & Processing Layer (Backend API & AI Engine)" {
  [FastAPI Gateway / REST Router] as APIGateway
  [Auth Middleware & RBAC Guard] as AuthGuard
  [Resume & Parsing Service] as ResumeService
  [Job Management Service] as JobService
  [Hybrid Matching & Gap Engine] as MatchService
  
  queue "Task Queue (Redis / Celery)" as TaskQueue
  [Background AI Worker] as Worker
  
  APIGateway --> AuthGuard
  AuthGuard --> ResumeService
  AuthGuard --> JobService
  AuthGuard --> MatchService
  
  ResumeService --> TaskQueue : Enqueue parsing task
  MatchService --> TaskQueue : Enqueue match task
  TaskQueue --> Worker : Dequeue & Process
  
  package "NLP / AI Pipelines" {
    [pdfplumber / PyMuPDF] as Parser
    [sentence-transformers (bge-m3)] as EmbeddingModel
    [Rule-based / Rank-BM25] as BM25Engine
  }
  
  Worker --> Parser
  Worker --> EmbeddingModel
  Worker --> BM25Engine
}

database "Data Persistence Layer (Cơ sở dữ liệu & Lưu trữ)" {
  folder "Local / Cloud File Storage" as Storage {
    [Thư mục lưu file CV gốc (.pdf, .docx)] as FileStorage
  }
  
  database "PostgreSQL 16 + pgvector" as MainDB {
    [Quan hệ người dùng & Nghiệp vụ (3NF)] as RelationalData
    [Chỉ mục Vector HNSW (1024 chiều)] as VectorIndex
  }
  
  database "Redis In-Memory Cache" as CacheDB {
    [Session & Revoked Tokens] as TokenCache
  }
}

' Kết nối luồng
ClientCandidate --> FrontendApp : HTTPS
ClientHR --> FrontendApp : HTTPS

APIClient --> APIGateway : REST API calls (JSON)

ResumeService --> FileStorage : Lưu file vật lý
Worker --> FileStorage : Đọc file để bóc tách

AuthGuard --> CacheDB : Check token
ResumeService --> MainDB : CRUD DB
JobService --> MainDB : CRUD DB
MatchService --> MainDB : Truy vấn pgvector
Worker --> MainDB : Cập nhật kết quả bóc tách
@enduml