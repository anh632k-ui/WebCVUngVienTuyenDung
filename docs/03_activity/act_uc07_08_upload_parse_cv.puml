@startuml
skinparam monochrome true
skinparam shadowing false
title ACTIVITY - UC07/08 UPLOAD & PARSE CV WITH REVISION GUARD

start
:Candidate/HR chọn PDF/DOCX;
:Backend kiểm <=5MB + MIME/magic bytes;
if (file invalid?) then (Có)
  :413/415;
  stop
endif
:Lưu safe storage_key;
:Tạo Resume PENDING, revision=1, owner=current_user;
:Enqueue parse(resume_id, expected_revision=1);
:202 Accepted;

:Worker conditional claim PROCESSING
WHERE revision=expected_revision;
if (rowcount=0?) then (Có)
  :Stale task -> discard;
  stop
endif
:Extract text;
if (không có text?) then (Có)
  if (OCR Advanced bật?) then (Có)
    :OCR fallback;
  else (Không)
    :Conditional UPDATE FAILED + error
WHERE revision=expected_revision;
    stop
  endif
endif
:Parse entities/sections/skills;
:Map Skill Taxonomy seed;
:Generate embedding + model + preprocessing version;
:Conditional transaction persist aggregate + PARSED
WHERE revision=expected_revision;
if (terminal rowcount=0?) then (Có)
  :Stale result -> discard;
else (Không)
  :PARSED;
endif
stop
@enduml
