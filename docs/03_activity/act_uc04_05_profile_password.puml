@startuml
skinparam monochrome true
skinparam shadowing false

title ACTIVITY - UC04 PROFILE & UC05 ĐỔI MẬT KHẨU

start
:Authenticated User mở Account Settings;
:GET /api/v1/users/me;
:Backend lấy user_id từ JWT;
:SELECT users WHERE id=current_user.id;
:200 profile;

if (Cập nhật profile?) then (Có)
  :PUT /api/v1/users/me;
  :Validate full_name/phone_number;
  :UPDATE chính current_user;
  :200 Updated;
endif

if (Đổi mật khẩu?) then (Có)
  :Nhập current_password + new_password;
  :PUT /api/v1/auth/change-password;
  :Verify current password hash;
  if (Đúng?) then (Có)
    :Validate password policy;
    if (Mật khẩu mới hợp lệ?) then (Có)
      :Hash new password;
      :UPDATE users.password_hash;
      :Revoke refresh sessions nếu module bật;
      :200 Password changed;
    else (Không)
      :422 Validation Error;
    endif
  else (Không)
    :400 Current password incorrect;
  endif
endif
stop
@enduml
