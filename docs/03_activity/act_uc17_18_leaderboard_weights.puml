@startuml
skinparam monochrome true
skinparam shadowing false
title ACTIVITY - UC17 LEADERBOARD / UC18 WEIGHTS

start
if (Xem leaderboard?) then (Có)
  :HR owner JD hoặc Admin;
  :GET /jobs/{id}/leaderboard;
  :Chỉ Match COMPLETED;
  if (HR?) then (Có)
    :Chỉ row có resume.owner_user_id=current_user.id;
  endif
  :Sort overall_score DESC;
  :200 LeaderboardResponse;
else (Cập nhật weights)
  :PUT /jobs/{id}/weights;
  :Validate mỗi weight [0,1], tổng=1;
  if (invalid?) then (Có)
    :422;
    stop
  endif
  :BEGIN TRANSACTION;
  :Update weights;
  :job.revision++;
  :Invalidate related Match:
generation++, PENDING, clear stale payload;
  :COMMIT;
  if (recalculate=true?) then (Có)
    :Dispatch task với generation/revision mới;
  endif
  :200 JobResponse;
endif
stop
@enduml
