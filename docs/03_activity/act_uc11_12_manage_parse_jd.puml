@startuml
skinparam monochrome true
skinparam shadowing false
title ACTIVITY - UC11/12 QUẢN LÝ & PHÂN TÍCH JD

start
if (Tạo JD mới?) then (Có)
  :Chỉ HR;
  :POST /api/v1/jobs;
  :INSERT JD DRAFT/PENDING, revision=1,
recruiter_id=current_user.id;
  :Enqueue parse(job_id, expected_revision=1);
else (Cập nhật JD hiện có)
  :HR owner hoặc Admin override;
  if (raw_content đổi?) then (Có)
    :BEGIN;
    :job.revision++;
    :status=DRAFT; parsing_status=PENDING;
    :verified=false; clear embedding/model/preprocessing/parsed_at;
    :Invalidate Match liên quan:
generation++, PENDING, clear payload;
    :COMMIT;
    :Enqueue parse(job_id, expected_revision=new_revision);
  endif
endif

:Worker nhận parse(job_id, expected_revision);
:Conditional claim PROCESSING nếu revision còn khớp;
if (claim được?) then (Có)
  :Extract/normalize criteria + embedding;
  :Conditional terminal write PARSED/FAILED
WHERE revision=expected_revision;
  if (rowcount=0?) then (Có)
    :Stale task -> discard;
  endif
else (Không)
  :Stale task -> discard;
endif

if (PATCH status?) then (Có)
  :Áp dụng transition matrix;
  if (DRAFT -> CLOSED?) then (Có)
    :422;
  else (Hợp lệ)
    if (target ACTIVE?) then (Có)
      :Require PARSED + verified + embedding/model/preprocessing + >=1 skill;
    endif
    :Update status;
  endif
endif
stop
@enduml
