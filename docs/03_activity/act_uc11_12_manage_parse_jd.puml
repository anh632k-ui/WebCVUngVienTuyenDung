@startuml
skinparam monochrome true
skinparam shadowing false
title ACTIVITY - UC11/12 QUẢN LÝ & PHÂN TÍCH JD - IDEMPOTENT + EXCLUSIVE CAS

start
if (Tạo JD mới?) then (Có)
  :Chỉ HR;
  :Client tạo Idempotency-Key UUID;
  :POST /api/v1/jobs + Idempotency-Key;
  :Derive job_id UUIDv5(actor,route,key);
  :INSERT JD DRAFT/PENDING revision=1 nếu chưa tồn tại;
  if (same idempotency key đã tồn tại?) then (Có)
    :Dùng lại cùng JD, không tạo duplicate;
  endif
  :COMMIT;
  :Best-effort enqueue parse(job_id,current_revision=1);
  if (dispatcher lỗi?) then (Có)
    :Log lỗi + giữ JD PENDING;
    :Recovery sweeper sẽ re-dispatch current_revision;
  endif
  :201 JobResponse;
else (Cập nhật JD hiện có)
  :HR owner hoặc Admin override;
  if (raw_content đổi?) then (Có)
    :Require is_deleted=FALSE;
    :BEGIN;
    :job.revision++ TRƯỚC computation mới;
    :status=DRAFT; parsing_status=PENDING;
    :verified=false; clear embedding/model/preprocessing/parsed_at;
    :Invalidate Match liên quan:
generation++, refresh revision snapshots,
PENDING, clear stale payload;
    :COMMIT;
    :Best-effort enqueue parse(job_id, expected_revision=new_revision);
    if (dispatcher lỗi?) then (Có)
      :Log lỗi; recovery sweeper sẽ re-dispatch;
    endif
  endif
endif

:Worker nhận parse(job_id, expected_revision);
:Exclusive CAS claim PROCESSING
WHERE revision=expected_revision
AND parsing_status=PENDING
AND is_deleted=FALSE;
if (claim rowcount=0?) then (Có)
  :Stale/duplicate/deleted task -> discard;
  stop
endif
:Extract/normalize criteria + embedding;
if (parse lỗi?) then (Có)
  :CAS FAILED + parsing_error_message
WHERE revision=expected_revision
AND parsing_status=PROCESSING
AND is_deleted=FALSE;
  stop
endif
:BEGIN terminal transaction;
:Lock/check JD vẫn PROCESSING,
revision=expected_revision,
is_deleted=FALSE;
if (check fail?) then (Có)
  :ROLLBACK + stale/duplicate/deleted discard;
else (Hợp lệ)
  :Replace job_skills + parsed fields;
  :CAS PARSED
WHERE revision=expected_revision
AND parsing_status=PROCESSING
AND is_deleted=FALSE;
  :COMMIT;
  :Worker KHÔNG tăng revision khi commit;
endif

if (PATCH status?) then (Có)
  :Require is_deleted=FALSE;
  :Áp dụng transition matrix;
  if (DRAFT -> CLOSED?) then (Có)
    :422;
  else (Hợp lệ)
    if (target ACTIVE?) then (Có)
      :Require PARSED + verified + embedding/model/preprocessing + >=1 skill;
    endif
    :Update status;
  endif
endif
stop

legend bottom
Recovery sweeper chỉ re-dispatch JD PENDING + is_deleted=FALSE quá grace window bằng current revision.
Không reset PROCESSING timeout trong MVP nếu chưa có lease/attempt token.
Concurrent soft-delete làm terminal CAS fail/rollback.
endlegend
@enduml
