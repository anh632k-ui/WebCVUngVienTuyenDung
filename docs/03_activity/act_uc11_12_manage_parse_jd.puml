@startuml
skinparam monochrome true
skinparam shadowing false

title ACTIVITY - UC11 QUẢN LÝ JD & UC12 PHÂN TÍCH JD

start
:HR/Admin mở màn hình quản lý JD;

if (Tạo JD mới?) then (Có)
  :Nhập title, level, location, raw_content
  và weights;
  :POST /api/v1/jobs;
  :Backend kiểm HR/Admin + validate tổng weights=1;
  :INSERT job_descriptions
  status=DRAFT, parsing_status=PENDING;
  :Kích hoạt JD parse task;
  :201 Created;
else (Không)
  if (Cập nhật JD?) then (Có)
    :PUT /api/v1/jobs/{id};
    :Backend kiểm recruiter_id=current_user hoặc Admin;
    if (raw_content thay đổi?) then (Có)
      :BEGIN TRANSACTION;
      :UPDATE metadata;
      :SET status=DRAFT,
      parsing_status=PENDING,
      is_criteria_verified=false,
      job_embedding=NULL,
      embedding_model=NULL,
      parsed_at=NULL;
      :Invalidate mọi match_results của JD:
      status=PENDING,
      scores=NULL,
      matched_skills=[], missing_skills=[],
      gap_analysis_summary=NULL,
      error_message=NULL,
      calculated_at=NULL,
      updated_at=NOW();
      :COMMIT;
      :Kích hoạt parse lại;
      :200 OK;
    else (Không)
      :UPDATE metadata;
      :200 OK;
      stop
    endif
  else (Không)
    if (Đổi trạng thái?) then (Có)
      :PATCH /api/v1/jobs/{id}/status;
      :Backend kiểm ownership/Admin;
      if (status mới = ACTIVE?) then (Có)
        if (JD PARSED + criteria verified
        + embedding hợp lệ + có >=1 job_skill?) then (Có)
          :UPDATE status=ACTIVE;
          :200 OK;
        else (Không)
          :422 JD chưa sẵn sàng công bố;
        endif
      else (DRAFT/CLOSED)
        :UPDATE status;
        :200 OK;
      endif
      stop
    else (Xóa JD)
      :DELETE /api/v1/jobs/{id};
      :Backend kiểm ownership/Admin;
      :SET is_deleted=true, deleted_at=NOW();
      :204 No Content;
      stop
    endif
  endif
endif

:Worker nhận job_id cần parse;
:UPDATE parsing_status=PROCESSING;
:Normalize + section JD;
:Trích min experience và education requirement;
:Trích skills;
:Map Skill Taxonomy;
:Phân loại MANDATORY/OPTIONAL;
:Sinh job_embedding + embedding_model;
if (Phân tích thành công?) then (Có)
  :BEGIN TRANSACTION;
  :Replace job_skills;
  :UPDATE JD parsed fields,
  parsing_status=PARSED, parsed_at=NOW();
  :COMMIT;
else (Không)
  :UPDATE parsing_status=FAILED,
  parsing_error_message;
endif
stop
@enduml
