@startuml
skinparam monochrome true
skinparam shadowing false
title ACTIVITY - UC02 LOGIN / UC03 REFRESH [ADVANCED]

start
:Guest nhập email/password;
:POST /api/v1/auth/login;
:Normalize email + verify password hash;
if (credential sai?) then (Có)
  :401;
  stop
endif
if (is_active=false?) then (Có)
  :403;
  stop
endif
:Issue JWT Access Token;
:200 LoginResponse;

note right
MVP dừng ở Access Token.
Logout UI = bỏ token phía client.
end note

if (Advanced Refresh Session được bật?) then (Có)
  :Backend set HttpOnly refresh cookie;
  :POST /auth/refresh để rotate;
  :POST /auth/logout để revoke;
else (Không)
  :Không expose refresh/logout route server-side trong OpenAPI MVP;
endif
stop
@enduml
