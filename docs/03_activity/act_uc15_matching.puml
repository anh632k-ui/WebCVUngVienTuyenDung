@startuml
skinparam monochrome true
skinparam shadowing false

title ACTIVITY - UC15 TÍNH MỨC ĐỘ TƯƠNG THÍCH

start
:Candidate/HR/Admin chọn JD và CV;
:POST /api/v1/matching/calculate
{ job_id, resume_ids[] };
:Backend xác thực role + ownership;
if (Caller có quyền với JD/CV?) then (Có)
  :Kiểm tra CV PARSED, JD PARSED,
  is_criteria_verified=true,
  có >=1 job_skill,
  embedding hợp lệ,
  chưa soft-delete;
  if (Candidate?) then (Có)
    :Kiểm tra JD status=ACTIVE;
  endif
  if (HR?) then (Có)
    :Kiểm tra JD thuộc HR
    và mọi CV đều thuộc kho HR;
  endif
  if (Tài nguyên sẵn sàng?) then (Có)
    :UPSERT match_results;
    :SET status=PENDING,
    overall/skill/semantic/experience=NULL,
    matched_skills=[], missing_skills=[],
    gap_analysis_summary=NULL,
    error_message=NULL,
    calculated_at=NULL,
    updated_at=NOW();
    :Queue một task cho mỗi resume_id;
    :202 { job_id, match_ids[],
    total_matches, status=PENDING };
  else (Không)
    :422 Resource not ready;
    stop
  endif
else (Không)
  :403/404;
  stop
endif

:Worker nhận match_id;
:UPDATE status=PROCESSING;
:Load normalized CV skills + JD skills;
:Compute Skill Score
(MANDATORY ưu tiên hơn OPTIONAL);
:Load resume_embedding + job_embedding;
:Compute Cosine Similarity;
:Semantic Score = 100 * clamp(cosine, 0, 1);
if (BM25 experimental được bật?) then (Có)
  :Compute/log normalized BM25
cho diagnostic/reranking experiment;
  note right
    hybrid-v1 KHÔNG blend BM25
    vào Semantic/Overall Score.
    Muốn blend phải đổi algorithm_version.
  end note
endif
:Compute Experience Score;
:Overall = w_skill*Skill
+ w_semantic*Semantic
+ w_experience*Experience;
:Build matched_skills + missing_skills;
if (Tính toán thành công?) then (Có)
  :UPDATE scores 0..100,
  evidence,
  status=COMPLETED,
  algorithm_version=hybrid-v1,
  calculated_at=NOW(),
  updated_at=NOW();
else (Không)
  :UPDATE status=FAILED,
  error_message,
  updated_at=NOW();
endif
stop
@enduml
