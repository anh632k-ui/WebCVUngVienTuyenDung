@startuml
skinparam monochrome true
skinparam shadowing false
title ACTIVITY - UC15 MATCHING SINGLE/BATCH

start
:POST /api/v1/matching/calculate;
:Load JD + toàn bộ Resume IDs;
:Validate ownership/readiness/model+preprocessing cho toàn batch;
if (có bất kỳ item invalid?) then (Có)
  :403/404/422;
  :Không mutate Match nào;
  stop
endif
:BEGIN TRANSACTION;
repeat
  :UPSERT current Match pair;
  :generation++;
  :snapshot resume_revision + job_revision;
  :PENDING + clear scores/evidence/error/provenance/calculated_at;
repeat while (còn resume?) is (Có)
:COMMIT;
:Dispatch task sau commit cho từng match_id
kèm expected generation/revisions;
if (dispatcher có lỗi?) then (Có)
  :503 TASK_DISPATCH_FAILED;
  :PENDING rows được phép retry;
  stop
endif
:202 {match_ids,total_matches,status=PENDING};

:Worker conditional claim PROCESSING
WHERE generation=expected_generation;
if (claim rowcount=0?) then (Có)
  :Stale task -> discard;
  stop
endif
:Load Resume/JD + re-check revisions
+ model/preprocessing;
if (revision/version mismatch?) then (Có)
  :Stale task -> discard;
  stop
endif
:Compute Skill/Semantic/Experience/Overall;
:Conditional terminal UPDATE COMPLETED
chỉ nếu generation + linked revisions vẫn khớp;
if (rowcount=0?) then (Có)
  :Stale result -> discard;
else (Không)
  :Persist scores/evidence/provenance/calculated_at;
endif
stop
@enduml
