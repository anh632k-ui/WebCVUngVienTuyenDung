@startuml
skinparam monochrome true
skinparam shadowing false
title ACTIVITY - UC15 MATCHING SINGLE/BATCH - EXCLUSIVE CAS

start
:POST /api/v1/matching/calculate;
:Load JD + toàn bộ Resume IDs;
:Validate ownership/readiness/model+preprocessing
+ Resume/JD is_deleted=FALSE cho toàn batch;
if (có bất kỳ item invalid?) then (Có)
  :403/404/422;
  :Không mutate Match nào;
  stop
endif
:BEGIN TRANSACTION;
repeat
  :UPSERT current Match pair;
  :generation++;
  :snapshot current resume_revision + job_revision;
  :PENDING + clear scores/evidence/error/provenance/calculated_at;
repeat while (còn resume?) is (Có)
:COMMIT;
:Dispatch task sau commit cho từng match_id
kèm expected generation/revisions;
if (dispatcher có lỗi?) then (Có)
  :503 TASK_DISPATCH_FAILED;
  :PENDING rows được phép retry;
  stop
endif
:202 {match_ids,total_matches,status=PENDING};

:Worker nhận expected generation/revisions;
:Exclusive CAS claim PENDING -> PROCESSING
chỉ khi generation + snapshot revisions
+ linked Resume/JD revisions đều khớp expected
+ linked resources is_deleted=FALSE;
if (claim rowcount=0?) then (Có)
  :Stale/duplicate/deleted task -> discard;
  stop
endif
:Load Resume/JD + criteria;
:Re-check model/preprocessing + is_deleted=FALSE;
if (version/deleted mismatch?) then (Có)
  :CAS FAILED chỉ khi status=PROCESSING
và expected generation/revisions vẫn khớp
và linked resources chưa xóa;
  stop
endif
:Compute Skill/Semantic/Experience/Overall;
:Conditional terminal CAS COMPLETED
WHERE status=PROCESSING
AND generation/snapshots/linked revisions
vẫn khớp expected
AND linked resources is_deleted=FALSE;
if (rowcount=0?) then (Có)
  :Stale/duplicate/deleted result -> discard;
else (Không)
  :Persist scores/evidence/provenance/calculated_at;
endif
stop

legend bottom
Duplicate queue delivery cùng generation chỉ một worker claim được.
FAILED/COMPLETED đều yêu cầu current status PROCESSING.
Concurrent soft-delete làm terminal CAS thất bại, không ghi output mới vào resource đã xóa.
endlegend
@enduml
