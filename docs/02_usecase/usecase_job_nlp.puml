@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

title USE CASE - PHÂN HỆ JD & NLP

actor Candidate
actor HR
actor Admin

rectangle "JD & NLP" {
  usecase "UC11 Quản lý JD\nCreate/Update/Delete/Status" as UC11
  usecase "UC12 Phân tích JD tự động" as UC12
  usecase "Phân đoạn JD" as J1
  usecase "Trích xuất kinh nghiệm/học vấn" as J2
  usecase "Chuẩn hóa kỹ năng" as J3
  usecase "Phân loại MANDATORY/OPTIONAL" as J4
  usecase "Sinh embedding JD" as J5
  usecase "UC13 Rà soát criteria JD" as UC13
  usecase "UC14 Xem JD đang tuyển" as UC14
}

HR --> UC11
HR --> UC13
Admin --> UC11
Candidate --> UC14

UC12 ..> UC11 : <<extend>>\n[tạo mới hoặc raw_content thay đổi]
UC12 ..> J1 : <<include>>
UC12 ..> J2 : <<include>>
UC12 ..> J3 : <<include>>
UC12 ..> J4 : <<include>>
UC12 ..> J5 : <<include>>

@enduml
