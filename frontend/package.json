{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mts",
    "test:production": "node tests/production-http-smoke.mjs",
    "test:auth": "node tests/auth-http-smoke.mjs",
    "test": "npm run test:unit && npm run test:production && npm run test:auth && npm run test:resume && npm run test:jobs && npm run test:matching && npm run test:leaderboard",
    "test:resume": "node tests/resume-http-smoke.mjs",
    "test:jobs": "node tests/jobs-http-smoke.mjs",
    "test:matching": "node tests/matching-http-smoke.mjs",
    "test:leaderboard": "node tests/leaderboard-http-smoke.mjs"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
