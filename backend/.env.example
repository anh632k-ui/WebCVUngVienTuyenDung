# Copy this file to backend/.env and replace placeholders locally.
# Never commit the resulting .env file.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/webcv_ungvien
DATABASE_CONNECT_TIMEOUT_SECONDS=5
JWT_SECRET_KEY=<generate-a-strong-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
RESUME_STORAGE_ROOT=../.local/resume_storage
# Optional (for example, redis://localhost:6379/0). Blank keeps dispatch/recovery disabled.
CELERY_BROKER_URL=
RESUME_RECOVERY_GRACE_SECONDS=300
RESUME_RECOVERY_INTERVAL_SECONDS=60
RESUME_RECOVERY_BATCH_SIZE=100
JOB_RECOVERY_GRACE_SECONDS=300
JOB_RECOVERY_INTERVAL_SECONDS=60
JOB_RECOVERY_BATCH_SIZE=100
MATCH_RECOVERY_GRACE_SECONDS=300
MATCH_RECOVERY_INTERVAL_SECONDS=60
MATCH_RECOVERY_BATCH_SIZE=100
