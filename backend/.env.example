# Copy this file to backend/.env and replace placeholders locally.
# Never commit the resulting .env file.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/webcv_ungvien
DATABASE_CONNECT_TIMEOUT_SECONDS=5
JWT_SECRET_KEY=<generate-a-strong-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

